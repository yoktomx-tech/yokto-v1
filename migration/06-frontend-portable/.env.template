# =============================================================================
# YOKTO — Variables de entorno del hosting (Lovable / Vercel / CF Pages / etc.)
# =============================================================================
# Copiar en Lovable → Settings → Environment después del corte.
# Las VITE_* son legibles desde el navegador; las demás son server-only.

# ---- Supabase externo (nuevo proyecto del cliente) ----
VITE_SUPABASE_URL=https://<ref-nuevo>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon key del nuevo proyecto>

# Server-only (copiar mismo valor que arriba + service role)
SUPABASE_URL=https://<ref-nuevo>.supabase.co
SUPABASE_ANON_KEY=<anon key del nuevo proyecto>
SUPABASE_SERVICE_ROLE_KEY=<service role key, GUARDAR con add_secret, NUNCA comitir>

# ---- Integraciones externas (traer del proyecto Cloud actual) ----
NUBARIUM_USER=<...>
NUBARIUM_PASSWORD=<...>
VERIFICAMEX_API_KEY=<...>
VERIFICAMEX_WEBHOOK_TOKEN=<...>
COPOMEX_TOKEN=<...>
BANK_ACCOUNT_HASH_SECRET=<...>

# ---- Reemplazos de Lovable ----
# AI Gateway → Gemini directo
GOOGLE_GENERATIVE_AI_API_KEY=<crear en https://aistudio.google.com/app/apikey>

# Email → Resend
RESEND_API_KEY=<crear en https://resend.com/api-keys>
RESEND_FROM=YOKTO <no-reply@<tudominio>>

# Cron secret compartido entre hosting y pg_cron
CRON_SECRET=<32+ chars aleatorios; generar con generate_secret>

# ---- App ----
APP_URL=https://<dominio de producción>
