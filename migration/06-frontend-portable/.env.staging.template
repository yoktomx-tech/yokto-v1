# ============================================================================
# YOKTO Staging — Environment Template
# ============================================================================
# COPIAR como .env.staging y llenar con valores del proyecto Supabase staging.
# NUNCA commitear .env.staging con valores reales.
# NUNCA usar aquí URLs, keys o secretos del proyecto Cloud productivo
# (diqdpygummlrajsugotv).
# ============================================================================

# --- Cliente Supabase (browser) — CONFIGURACIÓN PRINCIPAL ---
# Contrato oficial post-migración: URL + publishable key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- App ---
VITE_APP_ENV=staging
VITE_APP_URL=
VITE_STAGING_BANNER=YOKTO STAGING — NO USAR PARA OPERACIONES REALES

# --- Compatibilidad legacy (opcional, sólo transición) ---
# Sólo si el código legacy aún lee VITE_SUPABASE_ANON_KEY. El nuevo cliente
# prefiere VITE_SUPABASE_PUBLISHABLE_KEY. Eliminar en la Fase 1.
# VITE_SUPABASE_ANON_KEY=

# --- Server (createServerFn / server routes / edge functions locales) ---
# NUNCA en variables VITE_*. Se leen dentro de handlers.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=

# --- Proveedores (SANDBOX únicamente) ---
NUBARIUM_USER=
NUBARIUM_PASSWORD=
VERIFICAMEX_API_KEY=
VERIFICAMEX_WEBHOOK_TOKEN=
COPOMEX_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Cifrado ---
BANK_ACCOUNT_HASH_SECRET=

# --- AI Gateway portable (Edge Function ai-gateway) ---
# Nombres genéricos. Sin dependencia de LOVABLE_API_KEY.
AI_PROVIDER=
AI_PROVIDER_API_KEY=
AI_DEFAULT_MODEL=
AI_MAX_INPUT_TOKENS=
AI_MAX_OUTPUT_TOKENS=
AI_REQUEST_TIMEOUT_MS=

# ============================================================================
# Prohibiciones absolutas en frontend:
#   - SUPABASE_SECRET_KEY
#   - SUPABASE_SERVICE_ROLE_KEY
#   - sb_secret_*
#   - service_role
#   - contraseña de PostgreSQL
#   - Personal Access Token
#   - claves de proveedores (Stripe secret, Nubarium, Verificamex, etc.)
#   - LOVABLE_API_KEY
# Ninguna de estas puede aparecer en variables VITE_* ni en el bundle browser.
# ============================================================================
