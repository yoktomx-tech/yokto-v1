# =============================================================================
# .env.example — Frontend externo apuntando a `yoktobox`
# =============================================================================
# Copia a .env.local (nunca commitear con valores reales).
# Los valores se obtienen del Dashboard de Supabase → yoktobox → Project
# Settings → API.
# =============================================================================

# ---------- Cliente (build-time, expuestas al bundle) -----------------------
VITE_SUPABASE_URL=https://REPLACE-WITH-YOKTOBOX-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=REPLACE-WITH-YOKTOBOX-PUBLISHABLE-KEY
VITE_APP_ENV=production

# ---------- Servidor (runtime, TanStack server functions) -------------------
# NUNCA prefijar con VITE_. Estas viven solo en el runtime del hosting.
SUPABASE_URL=https://REPLACE-WITH-YOKTOBOX-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=REPLACE-WITH-YOKTOBOX-PUBLISHABLE-KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE-WITH-YOKTOBOX-SERVICE-ROLE

# ---------- Prohibidas en el bundle cliente ---------------------------------
# STRIPE_SECRET_KEY=...           (solo server)
# STRIPE_WEBHOOK_SECRET=...       (solo server)
# NUBARIUM_PASSWORD=...           (solo server)
# VERIFICAMEX_API_KEY=...         (solo server)
# BANK_ACCOUNT_HASH_SECRET=...    (solo server)
# AI_PROVIDER_API_KEY=...         (solo en secretos de Edge Function)
